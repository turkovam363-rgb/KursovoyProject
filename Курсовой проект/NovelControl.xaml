<UserControl x:Class="Курсовой_проект.NovelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Курсовой_проект.Commands"
             mc:Ignorable="d" 
             MinHeight="720" MinWidth="1280"
             MaxHeight="1080" MaxWidth="1920"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <Grid Background="Black">
            <Image Stretch="UniformToFill" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{Binding CurrentBackground}" />
                        <Setter Property="Opacity" Value="1.0" />
                    </Style>
                </Image.Style>
            </Image>
        </Grid>

        <Image Stretch="Uniform"
               VerticalAlignment="Bottom"
               HorizontalAlignment="Center">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Source" Value="{Binding CurrentSprite}"/>
                    <Setter Property="Opacity" Value="1.0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSprite}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentSprite}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" 
                    Height="160" 
                    Margin="50,0,50,40" 
                    CornerRadius="15" 
                    BorderBrush="#FFB6C1" 
                    BorderThickness="2">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF0F5" Offset="0.0"/>
                        <GradientStop Color="#FFE4E1" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#FFC0CB" Opacity="0.6" ShadowDepth="3"/>
                </Border.Effect>

                <Grid Margin="30,20,30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding CharacterName}" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#D81B60" 
                               Margin="0,0,0,8">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="2" Color="White" ShadowDepth="1"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding DialogueText}" 
                               FontSize="18" 
                               Foreground="#333333" 
                               TextWrapping="Wrap" 
                               LineHeight="26"/>
                </Grid>
            </Border>
        </Grid>

        <Button Command="{Binding NextDialogueCommand}" 
                Background="Transparent" 
                BorderThickness="0" 
                Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>