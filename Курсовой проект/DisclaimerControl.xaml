<UserControl x:Class="Курсовой_проект.DisclaimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="720" MinWidth="1280"
             MaxHeight="1080" MaxWidth="1920"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="800">
            <TextBlock Text="ВНИМАНИЕ" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#D81B60" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Данная игра содержит тяжелые темы, включая упоминания суицида, расстройств пищевого поведения (РПП), буллинга и психологического давления. Проект носит художественный характер и не преследует цель кого-либо оскорбить или задеть. Если вы эмоционально уязвимы, пожалуйста, будьте осторожны при прохождении." 
                       FontSize="20" 
                       Foreground="#C2185B" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap" 
                       LineHeight="32"
                       Margin="0,0,0,40"/>

            <Button Content="Я понимаю, продолжить" 
                    Command="{Binding ProceedCommand}" 
                    Width="280" 
                    Height="50" 
                    HorizontalAlignment="Center"
                    Foreground="White" 
                    FontWeight="Bold" 
                    FontSize="18" 
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF69B4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1493"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>