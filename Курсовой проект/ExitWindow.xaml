<Window x:Class="Курсовой_проект.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Курсовой_проект"
        mc:Ignorable="d"
        Title="Выход" Height="250" Width="400"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#FF69B4" CornerRadius="20" BorderBrush="#FFFFB6C1" BorderThickness="3">
        <Border.Effect>
            <DropShadowEffect Color="#FFFF1493" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Точно хотите выйти? " 
                       Foreground="White" FontSize="24" FontFamily="Georgia" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>

            <TextBlock Text="Я буду скучать..." 
           Foreground="White" FontSize="24" FontFamily="Georgia" 
           HorizontalAlignment="Left" Margin="100,28,0,124" Grid.RowSpan="2"/>


            <Image Grid.Row="1" 
                   Source="pack://application:,,,/изображения и спрайты/чиби героиня.png" 
                   Stretch="Uniform" MaxHeight="90" Margin="0,12,0,0"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Да" Width="100" Height="35" Click="YesButton_Click"
            Background="#FF1493" Foreground="White" FontSize="16" FontFamily="Georgia"
            Margin="0,0,20,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Нет" Width="100" Height="35" Click="NoButton_Click"
            Background="#FFFFB6C1" Foreground="#FF1493" FontSize="16" FontFamily="Georgia"
            Margin="20,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
