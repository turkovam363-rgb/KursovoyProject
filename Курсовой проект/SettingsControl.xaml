<UserControl x:Class="Курсовой_проект.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="720" MinWidth="1280"
             MaxHeight="1080" MaxWidth="1920"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <Grid Background="Black"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">
            <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold" Foreground="#FFB6C1" HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" Color="White" ShadowDepth="1"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Громкость музыки" Foreground="#FFB6C1" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Slider Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01" Margin="0,0,0,30"/>

            <CheckBox Content="Полноэкранный режим" IsChecked="{Binding IsFullscreen, Mode=TwoWay}" Foreground="#FFB6C1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <Button Content="Назад" Command="{Binding CloseCommand}" Width="150" Height="40" Foreground="#D81B60" FontWeight="Bold" FontSize="16" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFF0F5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#FFB6C1" BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE4E1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>