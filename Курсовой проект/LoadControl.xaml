<UserControl x:Class="Курсовой_проект.LoadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="720" MinWidth="1280"
             MaxHeight="1080" MaxWidth="1920"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="Foreground" Value="#D81B60"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" BorderBrush="#FFB6C1" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE4E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Background>
        <ImageBrush ImageSource="/изображения и спрайты/фон сохранения и загрузки.jpg" Stretch="UniformToFill"/>
    </UserControl.Background>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
            <TextBlock Text="{Binding TitleText}" FontSize="28" FontWeight="Bold" Foreground="#FFB6C1" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" Color="White" ShadowDepth="1"/>
                </TextBlock.Effect>
            </TextBlock>

            <Button Content="{Binding Slot1Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="1"/>
            <Button Content="{Binding Slot2Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="2"/>
            <Button Content="{Binding Slot3Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="3"/>
            <Button Content="{Binding Slot4Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="4"/>
            <Button Content="{Binding Slot5Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="5"/>
            <Button Content="{Binding Slot6Text}" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="6" Margin="0,0,0,25"/>
            <Button Content="Назад" Style="{StaticResource SlotButtonStyle}" Command="{Binding BackCommand}" Width="150" Height="40" Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>