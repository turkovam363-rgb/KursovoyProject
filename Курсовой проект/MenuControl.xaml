<UserControl x:Class="Курсовой_проект.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Курсовой_проект"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="NeonMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF69B4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="ButtonBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="#FFFFB6C1" 
                                    BorderThickness="3" 
                                    CornerRadius="30">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFF1493" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1493"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>

                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                         To="5" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                         To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                         To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <ImageBrush ImageSource="/изображения и спрайты/фон.jpg" 
                        Stretch="UniformToFill" 
                        RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Grid.Background>

        <Viewbox Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="1">
            <Grid Width="1280" Height="720">
                <Image Source="pack://application:,,,/изображения и спрайты/героиня меню.png" 
                       VerticalAlignment="Bottom" 
                       HorizontalAlignment="Right" 
                       Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <TranslateTransform X="120"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Stretch" Panel.ZIndex="2">
            <Grid Width="420" Height="720">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="65,0,0,0">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,34">
                        <TextBlock Text="Sweet" FontSize="76" FontFamily="Gabriola" Foreground="#FFFF8DA9">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFC71585" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Candies" FontSize="64" FontFamily="Gabriola" Foreground="#FFFF8DA9" Margin="22,-32,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFC71585" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="Начать" Style="{StaticResource NeonMenuButtonStyle}" Command="{Binding StartGameCommand}"/>
                    <Button Content="Загрузить" Style="{StaticResource NeonMenuButtonStyle}" Command="{Binding LoadGameCommand}"/>
                    <Button Content="Настройки" Style="{StaticResource NeonMenuButtonStyle}" Command="{Binding SettingsCommand}"/>
                    <Button Content="Галерея" Style="{StaticResource NeonMenuButtonStyle}" Command="{Binding GalleryCommand}"/>
                    <Button Content="Выход" Style="{StaticResource NeonMenuButtonStyle}" Command="{Binding ExitCommand}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>