<Window x:Class="Курсовой_проект.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уведомление" Height="220" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    
    <Border Background="#FFFFF0F5" CornerRadius="15" BorderBrush="#FF69B4" BorderThickness="3" Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Border Background="#FF69B4" CornerRadius="11,11,0,0">
                <TextBlock x:Name="TitleText" Text="Заголовок" Foreground="White" FontSize="18" 
                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="MessageText" Text="Текст сообщения" Grid.Row="1" 
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" 
                       HorizontalAlignment="Center" FontSize="16" Foreground="#FF1493" Margin="20,10,20,10"/>

            <Button Content="ОК" Grid.Row="2" Width="120" Height="40" Margin="0,0,0,10"
                    Foreground="White" FontSize="18" FontWeight="Bold" Cursor="Hand" Click="OkButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#FF69B4" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF1493"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C71585"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>