<Window x:Class="Курсовой_проект.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Курсовой_проект"
        xmlns:viewmodels="clr-namespace:Курсовой_проект.ViewModels"
        mc:Ignorable="d"
        Title="Sweet Candies"
        MinHeight="720" MinWidth="1280"
        MaxHeight="1080" MaxWidth="1920"
        Icon="pack://application:,,,/изображения и спрайты/иконка.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:MenuViewModel}">
            <local:MenuControl/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:NovelViewModel}">
            <local:NovelControl/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentView}" />
    </Grid>
</Window>

