<Window x:Class="Курсовой_проект.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFF0F5" ResizeMode="NoResize"
        Icon="pack://application:,,,/изображения и спрайты/иконка.ico">

    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#FF1493"/>
            <Setter Property="Background" Value="#FFFFB6C1"/>
        </Style>

        <Style x:Key="PinkWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1493"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#FFFFB6C1"
                                    BorderThickness="2"
                                    CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFFB6C1" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFB6C1"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF1493"/>
                                <Setter Property="Foreground" Value="#FF1493"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF1493" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FFFFB6C1" BorderThickness="4" Margin="10" CornerRadius="15" Background="White">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Настройки" FontSize="32" FontFamily="Georgia" Foreground="#FF1493"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скорость текста:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Авточтение:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер шрифта:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="12" Maximum="30" Value="18" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Яркость экрана:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Громкость музыки:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Громкость звуков:" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0">
                    <CheckBox Content="Полноэкранный режим" FontSize="16" FontFamily="Georgia" Foreground="#FF69B4"
                              IsChecked="{Binding IsFullscreen, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="2" Content="Назад"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource PinkWindowButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>

